<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Consumer Register</title>
    <link rel="stylesheet" href="/styles/consumer/register-consumer.css">
</head>
<body>
    <div class="container">
        <% if (error) { %>
            <p class="error">
                <%= error %>
            </p>
        <% } %>
        <form action="/register-consumer" method="POST" id="register_form">
            <h2>Consumer Register</h2>
                <div class="input_container">
                    <label>Email</label>
                    <input type="email" name="email" value="<%= old.email || '' %>" required>
                </div>
                <div class="input_container">
                    <label>Full Name</label>
                    <input type="text" name="fullName" value="<%= old.fullName || '' %>" required>
                </div>
                <div class="input_container">
                    <label>Password</label>
                    <input type="password" name="password" required>
                </div>
                <div class="input_container">
                    <label>City</label>
                    <input type="text" name="city" value="<%= old.city || '' %>" required>
                </div>
                <div class="input_container">
                    <label>District</label>
                    <input type="text" name="district" value="<%= old.district || '' %>" required>
                </div class="input_container">
                <button type="submit">Register</button>
                <div class="input_container"><a href="/" id="back-btn">Back to login</a></div>
        </form>
    </div>
</body>
</html>