<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Consumer Dashboard</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* ÜST BAR: logout solda, başlık ortada, profil sağda */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      position: relative;
    }

    .top-bar h1 {
      margin: 0;
      text-align: center;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .logout-btn {
      background: #d9d9d9;
      color: black;
      padding: 12px 24px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 6px;
    }

    .profile-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #d9d9d9;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      text-decoration: none;
      margin-left: auto;
    }

    /* ARAMA KUTUSU: input + buton yan yana */
    .search-bar {
      display: flex;
      margin-bottom: 30px;
      margin: 0 auto 30px;
    }

    .search-bar input {
      flex: 1;
      background: #d9d9d9;
      border: none;
      padding: 14px 20px;
      border-radius: 6px 0 0 6px;
      font-size: 16px;
    }

    .search-bar button {
      background: #888;
      color: white;
      border: none;
      width: 60px;
      height: 100%;
      border-radius: 0 6px 6px 0;
      font-size: 20px;
      cursor: pointer;
    }

    /* ÜRÜN LİSTESİNİ SARAN GRİ KUTU */
    /*.product-list-box {
      background: #d9d9d9;
      padding: 20px;
      border-radius: 6px;
    }  şimdilik commente aldım*/

    /* GRID: 4 sütunlu ürün düzeni */
    .products {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    /* TEK ÜRÜN KARTI */
    .product-card {
      width: 230px;
      background: white;
      border-radius: 6px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .product-img {
      background: #e74c3c;
      height: 150px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
    }

    .product-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-info {
      padding: 12px;
      flex: 1;
    }

    .product-info h3 {
      margin: 0 0 8px 0;
      text-align: center;
    }

    .product-info p {
      margin: 4px 0;
      font-size: 13px;
      text-align: left;
    }

    .price {
      font-weight: bold;
      font-size: 16px;
      text-align: center;
      margin-top: 10px;
    }

    /* MİKTAR SEÇİCİ: - input + */
    .qty-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      margin: 10px 0;
    }

    .qty-row button {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #888;
      color: white;
      border: none;
      cursor: pointer;
      padding: 0;
    }

    .qty-row input {
      width: 40px;
      height: 32px;
      border-radius: 50%;
      border: none;
      background: white;
      text-align: center;
    }

    .add-cart-btn {
      background: black;
      color: white;
      border: none;
      padding: 8px;
      border-radius: 6px;
      margin: 0 12px 12px;
      cursor: pointer;
      font-weight: bold;
    }

    /* SAYFALAMA: yuvarlak numaralar */
    .pagination {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin: 20px 0;
    }

    .pagination a {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #6b4f4f;
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      font-weight: bold;
    }

    .pagination a.active {
      background: #4a2f2f;
    }

    /* SEPET BUTONU: sağ alt köşede sabit */
    .cart-btn {
      position: fixed;
      bottom: 30px;
      right: 30px;
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: #999;
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      text-decoration: none;
    }

    .empty-msg {
      text-align: center;
      padding: 30px;
    }
  </style>
</head>

<body>

  <div class="top-bar">
    <a href="/" class="logout-btn">← LOGOUT</a>
    <h1>Welcome, <%= userName || "Consumer" %>
    </h1>
    <a href="/profile" class="profile-icon">👤</a>
  </div>

  <form class="search-bar" action="/consumer/dashboard" method="GET">
    <input type="text" name="search" value="<%= search || '' %>" placeholder="Search product...">
    <button type="submit" class="searchb">🔍</button>
  </form>

  <h2 style="text-align:center">Product List</h2>

  <div class="product-list-box">
    <% if (products && products.length> 0) { %>
      <div class="products">
        <% products.forEach(product=> { %>
          <div class="product-card">

            <div class="product-img">
              <% if (product.image_path) { %>
                <img src="/uploads/<%= product.image_path %>" />
                <% } else { %>
                  NO IMAGE
                  <% } %>
            </div>

            <div class="product-info">
              <h3>
                <%= product.title %>
              </h3>
              <p>Market: <%= product.market_name %>
              </p>
              <p>District: <%= product.district %>
              </p>
              <p>Stock: <%= product.stock %>
              </p>
              <p>Expiration Date: <%= product.expiration_date.toLocaleDateString("tr-TR") %>
              </p>
              <p class="price">
                <%= product.discounted_price %> TL
              </p>
            </div>

            <form action="/cart/add" method="POST">
              <input type="hidden" name="productId" value="<%= product.id %>">
              <div class="qty-row">
                <button type="button" onclick="this.nextElementSibling.stepDown()">-</button>
                <input type="number" name="quantity" value="1" min="1">
                <button type="button" onclick="this.previousElementSibling.stepUp()">+</button>
              </div>
              <button type="submit" class="add-cart-btn">Add To Cart</button>
            </form>

          </div>
          <% }) %>
      </div>
      <% } else if (search) { %>
        <p class="empty-msg">No product found.</p>
        <% } else { %>
          <p class="empty-msg">Search a product to see discounted items.</p>
          <% } %>
  </div>

  <% if (products && products.length> 0) { %>
    <div class="pagination">
      <% for (let i=1; i <=4; i++) { %>
        <a href="?search=<%= search %>&page=<%= i %>" class="<%= page === i ? 'active' : '' %>">
          <%= i %>
        </a>
        <% } %>
    </div>
    <% } %>

      <a href="/cart" class="cart-btn">🛒</a>

</body>

</html>