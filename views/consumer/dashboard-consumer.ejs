<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Consumer Dashboard</title>
  <link rel="stylesheet" href="/styles/consumer/consumer-dashboard.css">
  <script src="/scripts/consumer/dashboard-consumer.js"></script>
</head>

<body>
  <div class="container">
    <div class="navbar">
      <a href="/" class="link-btn">Logout</a>
      <div class="search-bar">

        <form class="search-bar" action="/consumer/dashboard" method="GET">
          <input type="text" name="search" value="<%= search || '' %>" placeholder="Search product...">
          <button type="submit" class="searchb">🔍</button>
        </form>
      </div>
      <div>
        <a href="/profile" class="link-btn">Profil <span>isim</span></a>
        <a href="/cart" class="link-btn">Sepetim</a>
      </div>
    </div>
    <div class="content">
      <div class="products">
        <% if (products.length===0) { %>
            <h1>Please search!</h1>
          <%} else { %>
            <% products.forEach(p=> { %>
              <div class="product">
                <div class="img"><img src="/uploads/<%= p.image_path%>" style="height: 200px;"></div>
                <div class="product-info">
                  <div><span>Name: </span>
                    <%=p.title%>
                  </div>
                  <div><span>Stock: </span>
                    <%=p.stock%> Remaining
                  </div>
                  <div><span>Price: </span>
                    <%=p.normal_price%> tl
                  </div>
                  <div><span>Discounted Price: </span>
                    <%=p.discounted_price%> tl
                  </div>
                  <div><span>Expiration Date: </span>
                    <%=p.expiration_date.toLocaleDateString("tr-TR")%>
                  </div>
                  <div><span>Status: </span><%- p.remaining_days> 7 ? 'Safe' : p.remaining_days >= 0 ? 'About to expire!' : 'Expired'%></div>
                  <button class="add-to-cart" data-id="<%= p.id %>">Add to Cart</button>
                </div>
              </div>
              <% }) %>
      </div>

      <div class='pages'>
        <% for (let i=1; i <=page_count; i++) {%>
          <a class='pageNo <%= current_page === i ? "active" : ""%>' href='/consumer/dashboard?pageNumber=<%=i%>&search=<%= search %>'>
            <%=i%>
          </a>
          <%}%>
      </div>

      <%}%>

    </div>
  </div>
</body>

</html>