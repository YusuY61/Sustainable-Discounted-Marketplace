<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Market Register</title>
  <link rel="stylesheet" href="/styles/market/register-market.css">
</head>

<body>
  <!DOCTYPE html>
  <html lang="en">

  <head>
    <div class="container">

      <% if (error) { %>
          <p class="error">
            <%= error %>
          </p>
          <% } %>

      <form action="/register-market" method="POST" id="register_form">
        <h2>Market Register</h2>
            <div class="input_container">
              <label>Email</label>
              <input type="email" name="email" value="<%= old.email ?? '' %>" required>
            </div>
            <div class="input_container">
              <label>Market Name</label>
              <input type="text" name="marketName" value="<%= old.marketName ?? '' %>" required>
            </div>
            <div class="input_container">
              <label>Password</label>
              <input type="password" name="password" required>
            </div>
            <div class="input_container">
              <label>City</label>
              <input type="text" name="city" value="<%= old.city ?? '' %>" required>
            </div>
            <div class="input_container">
              <label>District</label>
              <input type="text" name="district" value="<%= old.district ?? '' %>" required>
            </div>
            <button type="submit">Register</button>
            <div class="input_container"><a href="/" id="back-btn">Back to login</a></div>
      </form>
    </div>

</body>

</html>