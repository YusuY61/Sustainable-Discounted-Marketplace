<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Market Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .top-bar h1 {
      margin: 0;
    }

    .logout-btn {
      background: #d9d9d9;
      color: black;
      padding: 12px 24px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 6px;
    }

    .profile-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #d9d9d9;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      text-decoration: none;
    }

    .dashboard {
      display: flex;
      gap: 20px;
    }

    .left-col {
      width: 320px;
    }

    .right-col {
      flex: 1;
    }

    .gray-box {
      background: #d9d9d9;
      padding: 20px;
      border-radius: 6px;
    }

    .gray-box h3 {
      margin-top: 0;
    }

    .gray-box label {
      display: block;
      margin-top: 12px;
      font-weight: bold;
      font-size: 14px;
    }

    .gray-box input {
      width: 100%;
      border-radius: 20px;
      border: none;
      padding: 8px 14px;
      background: white;
      margin-top: 4px;
    }

    .black-btn {
      width: 100%;
      background: black;
      color: white;
      border: none;
      padding: 14px;
      border-radius: 6px;
      margin-top: 12px;
      cursor: pointer;
      font-weight: bold;
    }

    .black-btn:hover {
      background: #333;
    }

    .product-list {
      min-height: 500px;
    }

    .table-wrap {
      background: white;
      border-radius: 12px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    td {
      padding: 12px 10px;
      vertical-align: middle;
      text-align: center;
      border-bottom: 1px solid #eee;
    }

    table tr:first-child td {
      background: black;
      color: white;
      font-weight: bold;
      border-bottom: none;
    }

    table tr:last-child td {
      border-bottom: none;
    }

    td img {
      width: 60px;
      height: 60px;
      object-fit: cover;
      border-radius: 6px;
    }

    tr.expired {
      background: #fee2e2;
    }

    .expired-text {
      color: #b91c1c;
      font-weight: bold;
    }

    .pill-link {
      display: inline-block;
      padding: 6px 14px;
      background: black;
      color: white;
      border-radius: 20px;
      text-decoration: none;
      font-size: 13px;
    }

    .pill-link:hover {
      background: #333;
    }

    .delBtn {
      background: #b91c1c;
      color: white;
      width: auto;
      padding: 6px 14px;
      border-radius: 20px;
      border: none;
      cursor: pointer;
      font-size: 13px;
      font-weight: bold;
    }

    .delBtn:hover {
      background: #ef4444;
    }

    #errors {
      color: red;
      margin-top: 20px;
    }
  </style>
</head>

<body>

  <div class="top-bar">
    <a href="/" class="logout-btn">← LOGOUT</a>
    <h1>Market Dashboard</h1>
    <a href="/profile" class="profile-icon">👤</a>
  </div>

  <% if (typeof message !=='undefined' && message) { %>
    <p class="success">
      <%= message %>
    </p>
    <% } %>

      <div class="dashboard">

        <div class="left-col">
          <form action="/market/dashboard" method="post" enctype="multipart/form-data">
            <div class="gray-box">
              <h3>Product Info</h3>

              <label>Full Name</label>
              <input name="name" type="text" placeholder="Value" />

              <label>Stock</label>
              <input name="stock" type="text" placeholder="Value" />

              <label>Price</label>
              <input name="normalPrice" type="text" placeholder="Value" />

              <label>Discounted Price</label>
              <input name="discountedPrice" type="text" placeholder="Value" />

              <label>Expiration Date</label>
              <input name="expirationDate" type="date" />

              <label>Image</label>
              <input name="image" type="file" accept="image/*" />
            </div>
            <button type="submit" class="black-btn">Add Product</button>
          </form>
        </div>

        <div class="right-col">
          <div class="gray-box product-list">
            <div class="table-wrap">
              <table>
                <tr>
                  <td>Image</td>
                  <td>Title</td>
                  <td>Stock</td>
                  <td>Normal Price</td>
                  <td>Discounted Price</td>
                  <td>Expiration Date</td>
                  <td>Status</td>
                  <td>Edit</td>
                  <td>Delete</td>
                </tr>
                <% const today=new Date(); today.setHours(0, 0, 0, 0); %>
                  <% arr.forEach( p=> {
                    const expired = p.expiration_date < today; %>
                      <tr class="<%= expired ? 'expired' : '' %>">
                        <td>
                          <% if (p.image_path) { %>
                            <img src="/uploads/<%= p.image_path %>" />
                            <% } %>
                        </td>
                        <td>
                          <%= p.title %>
                        </td>
                        <td>
                          <%= p.stock %>
                        </td>
                        <td>
                          <%= p.normal_price %> TL
                        </td>
                        <td>
                          <%= p.discounted_price %> TL
                        </td>
                        <td>
                          <%= p.expiration_date.toLocaleDateString("tr-TR") %>
                        </td>
                        <td>
                          <% if (expired) { %>
                            <span class="expired-text">EXPIRED</span>
                            <% } else { %>
                              Active
                              <% } %>
                        </td>
                        <td><a href="/market/edit-product/<%= p.id %>" class="pill-link">Edit</a></td>
                        <td>
                          <form action="/market/delete-product/<%= p.id %>" method="post">
                            <button class="delBtn" type="submit">Delete</button>
                          </form>
                        </td>
                      </tr>
                      <% }) %>
              </table>
            </div>
          </div>
          <form action="/market/delete-expired" method="post"
            onsubmit="return confirm('Are you sure you want to delete all expired products? This cannot be undone.');">
            <button type="submit" class="black-btn">Delete Expired Products</button>
          </form>
        </div>

      </div>

      <div id="errors">
        <% if(typeof errors !=='undefined' && errors.length> 0){ %>
          <h1 style="color: red;">Product couldn't be added:</h1>
          <% errors.forEach((e)=> { %>
            <p>
              <%= e %>
            </p>
            <% }) %>
              <% } %>
      </div>

</body>

</html>