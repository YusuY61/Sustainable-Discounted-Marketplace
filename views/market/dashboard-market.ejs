<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Market Dashboard</title>
  <link rel="stylesheet" href="/styles/market/market-dashboard.css">
</head>

<body>

  <div class="navbar">
    <a href="/market/dashboard" class="brand-nav">SUSTAINABLE DISCOUNT MARKET</a>

    <div class="nav-links">
      <a href="/profile" class="nav-link">Hi, <%= marketName %></a>
      <a href="/logout" class="nav-link">Logout</a>
    </div>
  </div>

  <div class="dashboard-layout">

    <!-- Left: Add Product form -->
    <aside class="add-section">
      <div class="add-card">
        <h2 class="section-title">Add New Product</h2>

        <% if (errors && errors.length > 0) { %>
          <% errors.forEach(error => { %>
            <p class="error"><%= error %></p>
          <% }) %>
        <% } %>

        <form action="/market/dashboard" method="post" enctype="multipart/form-data" id="add-form">

          <div class="input_container">
            <label for="product-name">Product Name</label>
            <input type="text" name="name" id="product-name" value="<%= oldForm.name || '' %>" required>
          </div>

          <div class="input_container">
            <label for="product-stock">Stock</label>
            <input type="number" name="stock" id="product-stock" value="<%= oldForm.stock || '' %>" required>
          </div>

          <div class="input_container">
            <label for="product-price">Price (TL)</label>
            <input type="number" name="normalPrice" id="product-price" step="0.01" value="<%= oldForm.normalPrice || '' %>" required>
          </div>

          <div class="input_container">
            <label for="product-discounted-price">Discounted Price (TL)</label>
            <input type="number" name="discountedPrice" id="product-discounted-price" step="0.01" value="<%= oldForm.discountedPrice || '' %>" required>
          </div>

          <div class="input_container">
            <label for="product-expiration-date">Expiration Date</label>
            <input type="date" name="expirationDate" id="product-expiration-date" value="<%= oldForm.expirationDate || '' %>" required>
          </div>

          <div class="input_container">
            <label for="product-image">Image</label>
            <input type="file" name="image" id="product-image" required>
          </div>

          <button type="submit" class="btn-primary">Add Product</button>

        </form>
      </div>
    </aside>

    <!-- Right: Products list -->
    <main class="products-section">

      <% if (typeof message !== 'undefined' && message) { %>
        <p class="success"><%= message %></p>
      <% } %>

      <% if (arr.length > 0) { %>

        <h2 class="section-title">My Products (<%= arr.length %>)</h2>

        <div class="products">
          <% arr.forEach(p => { %>
            <%
              let statusClass = 'safe';
              let statusText = 'Safe';
              if (p.remaining_days < 0) {
                statusClass = 'expired';
                statusText = 'Expired';
              } else if (p.remaining_days <= 7) {
                statusClass = 'warning';
                if (p.remaining_days === 0) statusText = 'Last day!';
                else if (p.remaining_days === 1) statusText = '1 day left';
                else statusText = p.remaining_days + ' days left';
              }
            %>

            <div class="product <%= statusClass === 'expired' ? 'expired-card' : '' %>">

              <div class="product-image">
                <% if (p.image_path) { %>
                  <img src="/uploads/<%= p.image_path %>" alt="<%= p.title %>">
                <% } else { %>
                  <div class="no-image">No image</div>
                <% } %>
              </div>

              <h3 class="product-title"><%= p.title %></h3>

              <div class="product-status status-<%= statusClass %>"><%= statusText %></div>

              <div class="product-stock">
                <%= p.stock %> in stock · expires <%= p.expiration_date.toLocaleDateString("tr-TR") %>
              </div>

              <div class="product-prices">
                <span class="old-price"><%= p.normal_price %> TL</span>
                <span class="new-price"><%= p.discounted_price %> TL</span>
              </div>

              <div class="product-actions">
                <a href="/market/edit-product/<%= p.id %>" class="product-action action-edit">Edit</a>
                <a href="/market/delete-product/<%= p.id %>" class="product-action action-delete">Delete</a>
              </div>

            </div>
          <% }) %>
        </div>

        <form action="/market/delete-expired" method="post"
              onsubmit="return confirm('Are you sure you want to delete all expired products? This cannot be undone.');"
              class="delete-expired-form">
          <button type="submit" class="btn-danger-outline">Delete All Expired Products</button>
        </form>

      <% } else { %>

        <div class="empty-state">
          <h2>No products yet</h2>
          <p>Use the form on the left to add your first product.</p>
        </div>

      <% } %>

    </main>

  </div>

</body>

</html>
