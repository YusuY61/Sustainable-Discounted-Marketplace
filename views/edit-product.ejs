<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Product</title>
  <link rel="stylesheet" href="/styles/edit-product.css">
</head>

<body>

  <div class="navbar">
    <a href="/market/dashboard" class="brand-nav">SUSTAINABLE DISCOUNT MARKET</a>

    <div class="nav-links">
      <a href="/market/dashboard" class="nav-link">← Back to dashboard</a>
      <a href="/logout" class="nav-link">Logout</a>
    </div>
  </div>

  <div class="container">

    <h1 class="page-title">Edit Product</h1>

    <% if (errors && errors.length > 0) { %>
      <% errors.forEach(error => { %>
        <p class="error"><%= error %></p>
      <% }) %>
    <% } %>

    <%
      const d = product.expiration_date;
      const dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    %>

    <form action="/market/edit-product/<%= product.id %>" method="post" enctype="multipart/form-data" id="edit-form">

      <div class="input_container">
        <label for="name">Product Name</label>
        <input type="text" name="name" id="name" value="<%= product.title %>" required>
      </div>

      <div class="input_container">
        <label for="stock">Stock</label>
        <input type="number" name="stock" id="stock" value="<%= product.stock %>" required>
      </div>

      <div class="form-row">
        <div class="input_container">
          <label for="normalPrice">Price (TL)</label>
          <input type="number" name="normalPrice" id="normalPrice" step="0.01" value="<%= product.normal_price %>" required>
        </div>

        <div class="input_container">
          <label for="discountedPrice">Discounted Price (TL)</label>
          <input type="number" name="discountedPrice" id="discountedPrice" step="0.01" value="<%= product.discounted_price %>" required>
        </div>
      </div>

      <div class="input_container">
        <label for="expirationDate">Expiration Date</label>
        <input type="date" name="expirationDate" id="expirationDate" value="<%= dateStr %>" required>
      </div>

      <div class="input_container">
        <label for="image">Image</label>
        <% if (product.image_path) { %>
          <div class="current-image">
            <img src="/uploads/<%= product.image_path %>" alt="<%= product.title %>">
          </div>
        <% } %>
        <input type="file" name="image" id="image" accept="image/*">
        <small class="hint">Leave empty to keep the current image.</small>
      </div>

      <button type="submit" class="btn-primary">Update Product</button>

    </form>

  </div>

</body>

</html>
