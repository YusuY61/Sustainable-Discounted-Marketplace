<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Edit Product</title>
  <link rel="stylesheet" href="/styles/edit-product.css" />
  </style>
</head>

<body>

  <div class="container">
    <% if (errors && errors.length > 0) { %>
      <div>
        <% errors.forEach(error => { %>
        <p class="error">⚠️<%= error %></p>
        <% }) %>
      </div>
    <% } %>
    <%
      const d = product.expiration_date;
      const dateStr = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    %>
    <form action="/market/edit-product/<%= product.id %>" method="post" enctype="multipart/form-data" id="edit_form">
      <h1>Edit Product</h1>
      <div class="gray-box">
        <div class="input_container">
          <label>Name</label>
          <input name="name" type="text" value="<%= product.title %>" required />
        </div>
        <div class="input_container">
          <label>Stock</label>
          <input name="stock" type="text" value="<%= product.stock %>" required />
        </div>
        <div class="input_container">
          <label>Normal Price</label>
          <input name="normalPrice" type="text" value="<%= product.normal_price %>" required />
        </div>
        <div class="input_container">
          <label>Discounted Price</label>
          <input name="discountedPrice" type="text" value="<%= product.discounted_price %>" required />
        </div>
        <div class="input_container">
          <label>Expiration Date</label>
          <input name="expirationDate" type="date" value="<%= dateStr %>" required />
        </div>
        <div >
          <label>Image:</label>
          <% if (product.image_path) { %>
            <div><img src="/uploads/<%= product.image_path %>" width="240" /></div>
          <% } %>
          <input name="image" type="file" accept="image/*" />
          <div>Leave empty to keep current image.</div>
        </div>
      </div>
      <button type="submit" class="black-btn">Update</button>
    </form>
    <a href="/market/dashboard" id="back-btn">Back</a>
  </div>

</body>

</html>
