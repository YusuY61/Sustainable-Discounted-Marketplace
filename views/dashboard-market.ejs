<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Market Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
  <style>
    body{
      max-width: 100%;
      /* background-color: #b91c1c; */
    }
    .container{
      display: flex;
      flex-direction: row;
      /* background-color: aqua; */
      max-width: fit-content;
    }

    .card{
      max-width: 1000px;
      margin-left: 50px;
      display: flex;
      flex-direction: column;
    }

    form {
      max-width: 200px;
    }

    tr.expired {
      background: #fee2e2;
    }

    td{
      padding: 10 12px;
      /* font-size: 18px; */
      vertical-align: middle;
      text-align: center;
    }

    td:nth-child(2) {
      width: 180px;
      max-width: 180px;
      white-space: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      text-overflow: clip;
      padding: 0 10px;
    }

    td img{
      width: 60px;
      height: 60px;
      object-fit: cover;
      display: block;
    }

    tr:first-child td{
      padding: 0px 10px;
    }

    .expired-text {
      color: #b91c1c;
      font-weight: bold;

    }

    .small-info {
      font-size: 12px;
      color: #555;
      text-align: left;
      margin-top: 8px;
    }

    #btns{
      margin-top: auto;
      display: flex;
      flex-direction: row;
      justify-content: space-between;

    }
    .delBtn{
      background: transparent;
      color: #b91c1c;
      margin-bottom: 16px;
    }
    .delBtn:hover{
      background-color: red;
      color: #ddd;
    }
    #errors{
      color: red;
    }
  </style>
</head>

<body>

  <h1>Market Dashboard</h1>
  <div class="container">
    

    <form action="/market/dashboard" method="post" enctype="multipart/form-data">
      <h2>Add Product</h2>
      <input name="name" type="text" placeholder="Name" />
      <input name="stock" type="text" placeholder="Stock" />
      <input name="normalPrice" type="text" placeholder="Normal Price" />
      <input name="discountedPrice" type="text" placeholder="Discounted Price" />
      <input name="expirationDate" type="date" placeholder="Expiration Date" />
      <input name="image" type="file" accept="image/*" />
      <p class="small-info">Products with past expiration dates will be marked as expired.</p>
      <button type="submit">ADD</button>
    </form>

    <div class="card">
      <!-- <p>Market user will manage products here.</p> -->
      <table>
        <tr>
          <td>Image</td>
          <td>Title</td>
          <td>Stock</td>
          <td>Normal Price</td>
          <td>Discounted Price</td>
          <td>Expiration Date</td>
          <td>Status</td>
          <td>Edit</td>
          <td>Delete</td>
        </tr>
        <% const today=new Date(); today.setHours(0, 0, 0, 0); %>
          <% arr.forEach( p=> {
            const expired = p.expiration_date < today; %>
              <tr class="<%= expired ? 'expired' : '' %>">
                <td>
                  <% if (p.image_path) { %>
                    <img src="/uploads/<%= p.image_path %>" width="60" />
                    <% } %>
                </td>
                <td>
                  <%= p.title %>
                </td>
                <td>
                  <%= p.stock %>
                </td>
                <td>
                  <%= p.normal_price %> TL
                </td>
                <td>
                  <%= p.discounted_price %> TL
                </td>
                <td>
                  <%= p.expiration_date.toLocaleDateString("tr-TR") %>
                </td>
                <td>
                  <% if (expired) { %>
                    <span class="expired-text">EXPIRED</span>
                    <% } else { %>
                      Active
                      <% } %>
                </td>
                <td>
                  <a href="/market/edit-product/<%= p.id %>">Edit</a>
                </td>
                <td>
                  <form action="/market/delete-product/<%= p.id %>" method="post">
                    <button class="delBtn" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
              <% }) %>
      </table>
      <div id="btns">
        <a href="/">Logout ➜]</a>
        <a href="/profile">Edit Profile👤</a>
      </div>
      
    </div>
  </div>
  <div id="errors">
    <% if(errors.length > 0){ %>
      <h1 style="color: red;">Product couldn't be added:</h1>
    <% errors.forEach((e) => { %>
      <p><%=e%></p>
    <% }) %>
    <%}%>

  </div>
</body>

</html>