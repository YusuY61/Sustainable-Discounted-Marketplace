<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Market Dashboard</title>
    <link rel="stylesheet" href="/style.css" />
    <style>
      form {
        max-width: 200px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Market Dashboard</h1>

      <form action="/market/dashboard" method="post">
        <input name="name" type="text" placeholder="Name" />
        <input name="stock" type="text" placeholder="Stock" />
        <input name="normalPrice" type="text" placeholder="Normal Price" />
        <input
          name="discountedPrice"
          type="text"
          placeholder="Discounted Price"
        />
        <input
          name="expirationDate"
          type="date"
          placeholder="Expiration Date"
        />
        <button type="submit">ADD</button>
      </form>

      <div class="card">
        <!-- <p>Market user will manage products here.</p> -->
        <table>
          <tr>
            <td>Title</td>
            <td>Stock</td>
            <td>Normal Price</td>
            <td>Discounted Price</td>
            <td>Expiration Date</td>
          </tr>
          <% arr.forEach( p => { %>
            <tr>
              <td><%= p.title %></td>
              <td><%= p.stock %></td>
              <td><%= p.normal_price %> TL</td>
              <td><%= p.discounted_price %> TL</td>
              <td><%= p.expiration_date.toLocaleDateString("tr-TR") %></td>
            </tr>
          <% }) %>
        </table>
        <a href="/">Logout</a>
      </div>
    </div>
  </body>
</html>
