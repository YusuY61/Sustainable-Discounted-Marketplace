<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>
  <link rel="stylesheet" href="/styles/profile.css">

</head>

<body>

<div class="container">
  
    <h2>My Profile</h2>
  
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
  
    <% if (success) { %>
      <p class="success"><%= success %></p>
    <% } %>
  
    <form action="/profile-update" method="POST" id="update_form">
        <div class="input_container">
          <label>Email: </label>
          <input type="email" name="email" value="<%= user.email || '' %>" required>
        </div>
  
        <div class="input_container">
          <label><%= user.role === 'market' ? 'Market Name: ' : 'Full Name:' %></label>
          <input type="text" name="name"
            value="<%= (user.role === 'market' ? user.market_name : user.full_name) || '' %>" required>
        </div>
  
        <div class="input_container">
          <label>City</label>
          <input type="text" name="city" value="<%= user.city || '' %>" required>
        </div>
  
        <div class="input_container">
          <label>District</label>
          <input type="text" name="district" value="<%= user.district || '' %>" required>
        </div>
  
        <hr>
        <small>Leave password fields empty if you don't want to change it.</small>
  
        <div class="input_container">
          <label>Current Password</label>
          <input type="password" name="currentPassword">
        </div>
  
        <div class="input_container">
          <label>New Password</label>
          <input type="password" name="newPassword">
        </div>
  
      <button type="submit" class="purple-btn">Update Profile</button>
    </form>
  
    <a href="<%= user.role === 'market' ? '/market/dashboard' : '/consumer/dashboard' %>" id="back-btn">Back to dashboard</a>
</div>

</body>

</html>
